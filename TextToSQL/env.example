# Copy to .env and fill in. Never commit .env.

# --- Option A: Qwen via Alibaba Cloud Model Studio (DashScope), international endpoint ---
LLM_API_KEY=sk-your-dashscope-key
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_READ_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_CIRCUIT_FAILURE_THRESHOLD=3
LLM_CIRCUIT_RESET_SECONDS=30
LLM_RETRY_JITTER_SEED=0
# Optional prices for structured call-cost telemetry (USD per 1M tokens).
# LLM_INPUT_USD_PER_1M=
# LLM_OUTPUT_USD_PER_1M=

# --- Option B: Qwen locally with Ollama (free, no key; slower on a laptop) ---
# ollama pull qwen2.5-coder:7b
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b

# --- Option C: Qwen via OpenRouter ---
# LLM_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=qwen/qwen-2.5-72b-instruct   # check the current model list

# Path where you unzipped Spider (contains dev.json and database/)
SPIDER_DIR=data/raw/spider

# --- Optional pinned local retrieval models ---
# Defaults and immutable revision pins are defined in src/knowledge/semantic_models.py.
# If overriding a model ID, also set its full 40-character commit revision.
# TEXTTOSQL_MODEL_CACHE=C:/protected/model-cache
# TEXTTOSQL_EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2
# TEXTTOSQL_EMBEDDING_MODEL_REVISION=2a7cca6ad7605f3183bce07f677bda658059bbe9
# TEXTTOSQL_RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
# TEXTTOSQL_RERANKER_MODEL_REVISION=f130f2b05c9b70e021b4833afe43c6993e2c7563

# --- Host-injected application-level scoring principals ---
# TEXTTOSQL_SCORING_PRINCIPALS=<host-authenticated-principal-id>
# This setting does not replace a separate OS account or protected ACL storage.
# Never commit real keys, credentials, private approval records or principal lists.
